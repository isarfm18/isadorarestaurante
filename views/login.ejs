<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Isadora's Restaurant - Login</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="login-body">

    <div class="login-page-wrapper">

        <div class="login-left-panel">
            <div class="login-form-card">
                <div class="login-header">
                    <img src="/images/logo.png" alt="Logo Isadora's Restaurant" class="login-header-logo">
                    <h1 class="login-title">Entrar</h1>
                    <p class="login-subtitle">Acesse sua conta do painel administrativo</p>
                </div>

                <form action="/login" method="POST" class="login-form">
                    <div class="input-group">
                        <label for="username">Usuário</label>
                        <input type="text" id="username" name="username" placeholder="Digite seu usuário" required>
                    </div>

                    <div class="input-group">
                        <label for="password">Senha</label>
                        <input type="password" id="password" name="password" placeholder="Digite sua senha" required>
                    </div>

                    <div class="login-options">
                        <a href="#" class="forgot-password">Esqueceu a senha?</a>
                    </div>

                    <button type="submit" class="btn-login">Entrar</button>
                </form>


                <div class="login-register-footer">
                    Não tem uma conta? <a href="#">Cadastre-se grátis</a>
                </div>
            </div>
        </div>


        <div class="login-right-panel">
            <div class="brand-glow-aura"></div>
            <div class="brand-showcase-container">
                <img src="/images/logo.png" alt="Logo Isadora's Restaurant" class="brand-showcase-logo">
                <div class="brand-showcase-name">Isadora's Restaurant</div>
                <p class="brand-showcase-desc">O sabor e a qualidade que você merece, direto na sua mesa.</p>
            </div>
        </div>
    </div>

</body>

</html>