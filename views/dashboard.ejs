<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <title>Isadora's Restaurant - Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <div class="header">
        <h1>Painel Administrativo - Isadora's Restaurant</h1>
        <div>
            <a href="/" style="color: var(--text-muted); text-decoration: none; font-weight: bold;">Sair</a>
        </div>
    </div>

    <div class="faturamento-card">
        <div>
            <h2 style="font-weight: 300; font-size: 18px;">Faturamento Hoje</h2>
            <div class="value">R$ <%= Number(faturamentoHoje).toFixed(2).replace('.', ',' ) %>
            </div>
        </div>
        <a href="/admin/export" class="btn btn-export" style="width: auto; padding: 15px 30px;">
            📊 Baixar Relatório (CSV)
        </a>
    </div>

    <div class="grid-forms">
        <div class="card">
            <h3>🍽️ Novo Item (Cardápio)</h3>
            <form action="/add-item" method="POST">
                <input type="text" name="name" placeholder="Nome (Ex: Marmita Vegana)" required>
                <select name="category" required>
                    <option value="" disabled selected>Selecione a Categoria...</option>
                    <option value="Principal">Principal</option>
                    <option value="Acompanhamento">Acompanhamento</option>
                    <option value="Bebida">Bebida</option>
                    <option value="Sobremesa">Sobremesa</option>
                </select>
                <input type="number" name="price" step="0.01" min="0.01" placeholder="Preço (Ex: 19.90)" required>
                <input type="text" name="description" placeholder="Descrição (Ex: Acompanha arroz e salada)">
                <button type="submit" class="btn">Cadastrar Item</button>
            </form>

            <details>
                <summary>📋 Ver Itens Cadastrados (<%= items.length %>)</summary>
                <div style="margin-top: 15px;">
                    <% const categories=['Principal', 'Acompanhamento' , 'Bebida' , 'Sobremesa' ];
                        categories.forEach(cat=> {
                        const catItems = items.filter(i => i.category === cat);
                        if (catItems.length > 0) {
                        %>
                        <h4 style="color: var(--primary); margin-bottom: 10px; margin-top: 10px;">
                            <%= cat %>
                        </h4>
                        <ul class="item-list">
                            <% catItems.forEach(item=> { %>
                                <li>
                                    <strong>
                                        <%= item.name %>
                                    </strong> - R$ <%= Number(item.price).toFixed(2) %>
                                        <% if (item.description) { %>
                                            <span class="item-desc">
                                                <%= item.description %>
                                            </span>
                                            <% } %>
                                </li>
                                <% }) %>
                        </ul>
                        <% } }); %>
                </div>
            </details>
        </div>

        <div class="card">
            <h3>🛒 Lançar Novo Pedido</h3>
            <form action="/orders" method="POST" id="new-order-form">
                <input type="text" name="customer_name" placeholder="Nome do Cliente (Ex: João)" required>

                <div id="items-container">
                    <div class="item-row">
                        <select name="item_ids" required>
                            <option value="" disabled selected>Selecione o Prato...</option>
                            <% items.forEach(item=> { %>
                                <option value="<%= item.id %>">
                                    <%= item.name %> - R$ <%= Number(item.price).toFixed(2) %>
                                </option>
                                <% }) %>
                        </select>
                    </div>
                </div>

                <button type="button" class="btn btn-export" style="margin-bottom: 15px;" onclick="addMoreItems()">+
                    Adicionar Outro Prato ao Pedido</button>
                <button type="submit" class="btn">Registrar Pedido Completo</button>
            </form>
        </div>
    </div>

    <div class="header" style="margin-bottom: 0;">
        <h2>📦 Controle da Cozinha <span style="font-size: 14px; color: var(--text-muted); font-weight: 300;">(Arraste
                os pedidos)</span></h2>
    </div>

    <div class="kanban-board">
        <% const statuses=[ { id: 'Aberto' , title: '🆕 Aberto' }, { id: 'Cozinha' , title: '🍳 Na Cozinha' }, {
            id: 'Entrega' , title: '🛵 Em Entrega' }, { id: 'Entregue' , title: '✅ Entregue' } ]; %>

            <% statuses.forEach(col=> { %>
                <div class="kanban-col" id="<%= col.id %>" ondragover="allowDrop(event)" ondrop="drop(event)">
                    <h3>
                        <%= col.title %>
                    </h3>
                    <% const colOrders=orders ? orders.filter(o=> o.status === col.id) : [];
                        %>
                        <% if (colOrders.length===0) { %>
                            <p class="empty-msg" style="color: #777; font-size: 13px; text-align: center;">Vazio</p>
                            <% } else { %>
                                <% colOrders.forEach(order=> { %>
                                    <div class="kanban-card" id="order-<%= order.id %>" draggable="true"
                                        ondragstart="drag(event)">
                                        <strong>#<%= order.id %> - <%= order.customer_name %></strong>
                                        <ul>
                                            <% order.itemsList.forEach(oi=> { %>
                                                <li>
                                                    <%= oi.item_name %>
                                                </li>
                                                <% }) %>
                                        </ul>
                                        <div
                                            style="font-weight: 600; color: var(--success); margin-bottom: 10px; font-size: 14px;">
                                            Total: R$ <%= Number(order.total).toFixed(2) %>
                                        </div>

                                        <div class="card-actions"
                                            style="display: flex; gap: 8px; align-items: center; justify-content: space-between; margin-top: 10px;">
                                            <form action="/cancel-order" method="POST" style="margin: 0; flex: 1;"
                                                class="cancel-form">
                                                <input type="hidden" name="order_id" value="<%= order.id %>">
                                                <button type="submit" class="btn btn-small btn-danger"
                                                    style="width: 100%; font-size: 12px; padding: 8px 10px;"
                                                    onclick="return confirm('Tem certeza que deseja cancelar este pedido?')">❌
                                                    Cancelar</button>
                                            </form>
                                            <button type="button" class="btn btn-small btn-success btn-move-next"
                                                onclick="moveNext('<%= order.id %>')"
                                                style="width: auto; padding: 8px 12px; margin-top: 0; font-size: 12px;">➡️</button>
                                        </div>
                                    </div>
                                    <% }) %>
                                        <% } %>
                </div>
                <% }) %>
    </div>

    <div id="toast" class="toast">Mensagem</div>

    <script>
        function showToast(message) {
            var toast = document.getElementById("toast");
            toast.textContent = message.replace(/_/g, ' ');
            toast.className = "toast show";
            setTimeout(function () { toast.className = toast.className.replace("show", ""); }, 3000);
        }

        window.onload = function () {
            const urlParams = new URLSearchParams(window.location.search);
            const toastMsg = urlParams.get('toast');
            if (toastMsg) {
                showToast(toastMsg);
                const newUrl = window.location.protocol + "//" + window.location.host + window.location.pathname;
                window.history.replaceState({ path: newUrl }, '', newUrl);
            }
        }

        function addMoreItems() {
            const container = document.getElementById('items-container');
            const row = document.createElement('div');
            row.className = 'item-row';
            row.style.display = 'flex';
            row.style.gap = '10px';
            row.style.alignItems = 'center';
            row.style.marginBottom = '15px';

            const originalSelect = document.querySelector('.item-row select');
            const select = originalSelect.cloneNode(true);
            select.value = "";
            select.style.marginBottom = "0";
            select.style.flex = "1";

            const removeBtn = document.createElement('button');
            removeBtn.type = 'button';
            removeBtn.className = 'btn btn-danger btn-small';
            removeBtn.style.marginTop = '0';
            removeBtn.style.width = 'auto';
            removeBtn.style.padding = '12px 15px';
            removeBtn.textContent = '❌';
            removeBtn.onclick = function () {
                row.remove();
            };

            row.appendChild(select);
            row.appendChild(removeBtn);
            container.appendChild(row);
        }

        function allowDrop(ev) {
            ev.preventDefault();
            ev.currentTarget.classList.add('drag-over');
        }

        function drag(ev) {
            ev.dataTransfer.setData("text", ev.currentTarget.id);
        }

        function drop(ev) {
            ev.preventDefault();
            ev.currentTarget.classList.remove('drag-over');

            var data = ev.dataTransfer.getData("text");
            var card = document.getElementById(data);

            var targetCol = ev.currentTarget;
            var newStatus = targetCol.id;
            var orderId = data.split('-')[1];

            var sourceCol = card.parentElement;
            targetCol.appendChild(card);

            const emptyMsgs = targetCol.querySelectorAll('.empty-msg');
            emptyMsgs.forEach(m => m.remove());

            // If source column becomes empty, show empty message
            if (sourceCol && sourceCol.querySelectorAll('.kanban-card').length === 0) {
                if (!sourceCol.querySelector('.empty-msg')) {
                    const emptyP = document.createElement('p');
                    emptyP.className = 'empty-msg';
                    emptyP.style.color = '#777';
                    emptyP.style.fontSize = '13px';
                    emptyP.style.textAlign = 'center';
                    emptyP.textContent = 'Vazio';
                    sourceCol.appendChild(emptyP);
                }
            }

            fetch('/update-order-status', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({ order_id: orderId, new_status: newStatus })
            })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        showToast('Status Atualizado');
                        if (data.faturamentoHoje !== undefined) {
                            document.querySelector('.faturamento-card .value').textContent =
                                'R$ ' + Number(data.faturamentoHoje).toFixed(2).replace('.', ',');
                        }
                    }
                })
                .catch(err => {
                    console.error(err);
                    showToast('Erro ao atualizar!');
                });
        }

        function moveNext(orderId) {
            const card = document.getElementById('order-' + orderId);
            if (!card) return;
            const currentCol = card.parentElement;
            const currentStatus = currentCol.id;

            const statuses = ['Aberto', 'Cozinha', 'Entrega', 'Entregue'];
            const currentIndex = statuses.indexOf(currentStatus);

            if (currentIndex !== -1 && currentIndex < statuses.length - 1) {
                const nextStatus = statuses[currentIndex + 1];
                const nextCol = document.getElementById(nextStatus);
                if (!nextCol) return;

                nextCol.appendChild(card);

                const emptyMsgs = nextCol.querySelectorAll('.empty-msg');
                emptyMsgs.forEach(m => m.remove());

                // If current column becomes empty, show empty message
                if (currentCol.querySelectorAll('.kanban-card').length === 0) {
                    if (!currentCol.querySelector('.empty-msg')) {
                        const emptyP = document.createElement('p');
                        emptyP.className = 'empty-msg';
                        emptyP.style.color = '#777';
                        emptyP.style.fontSize = '13px';
                        emptyP.style.textAlign = 'center';
                        emptyP.textContent = 'Vazio';
                        currentCol.appendChild(emptyP);
                    }
                }

                fetch('/update-order-status', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({ order_id: orderId, new_status: nextStatus })
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            showToast('Status Atualizado');
                            if (data.faturamentoHoje !== undefined) {
                                document.querySelector('.faturamento-card .value').textContent =
                                    'R$ ' + Number(data.faturamentoHoje).toFixed(2).replace('.', ',');
                            }
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        showToast('Erro ao atualizar!');
                    });
            }
        }

        document.querySelectorAll('.kanban-col').forEach(col => {
            col.addEventListener('dragleave', function (e) {
                this.classList.remove('drag-over');
            });
        });
    </script>
</body>

</html>