<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Isadora's Restaurant</title>
    <link rel="stylesheet" href="/styles.css">
</head>

<body>

    <div id="snackbar" class="toast">Ação realizada com sucesso!</div>

    <div class="header-container">
        <div class="header-info">
            <h1>Isadora's Restaurant</h1>
            <p>Bem-vindo ao painel de controle.</p>
            <br>
            <a href="/admin/export" class="btn btn-link">📥 Baixar Relatório (CSV)</a>
            <a href="/" class="btn btn-danger btn-link">Sair</a>
        </div>

        <div class="card card-highlight">
            <h3 class="highlight-title">Faturamento de Hoje</h3>
            <p class="highlight-value">R$ <%= faturamentoHoje.toFixed(2) %>
            </p>
            <small class="text-muted">(Apenas pedidos 'Entregues')</small>
        </div>
    </div>

    <div class="card">
        <h3>Registrar Novo Pedido</h3>

        <details class="menu-details">
            <summary class="menu-summary">🍽️ Ver Cardápio e Adicionar Itens</summary>
            <ul>
                <% if(menuItems && menuItems.length> 0) { %>
                    <% menuItems.forEach(item=> { %>
                        <li class="menu-item">
                            <div>
                                <strong class="text-white">
                                    <%= item.name %>
                                </strong> - R$ <%= Number(item.price).toFixed(2) %><br>
                                    <small class="text-light-muted">
                                        <%= item.description %>
                                    </small>
                            </div>
                            <button type="button" class="btn btn-sm"
                                onclick="adicionarAoPedido('<%= item.name %>', <%= item.price %>)">
                                + Adicionar
                            </button>
                        </li>
                        <% }) %>
                            <% } else { %>
                                <li>Nenhum item cadastrado no cardápio.</li>
                                <% } %>
            </ul>
        </details>

        <div id="carrinho" class="carrinho-box">
            <h4 class="carrinho-title">Carrinho:</h4>
            <ul id="lista-itens" class="carrinho-list"></ul>
            <h3 class="carrinho-total">Total: R$ <span id="total-pedido">0.00</span></h3>
        </div>

        <form action="/orders" method="POST">
            <input type="text" name="customer_name" placeholder="Nome do Cliente (Ex: Mesa 04 ou João)" required>

            <input type="hidden" id="input-descricao" name="items_description" required>
            <input type="hidden" id="input-total" name="total" required>

            <button type="submit" class="btn btn-success">✅ Concluir e Enviar Pedido</button>
        </form>
    </div>

    <div class="card">
        <details>
            <summary class="menu-summary">➕ Cadastrar Novo Prato no Cardápio</summary>
            <div class="form-group-mt">
                <form action="/add-item" method="POST">
                    <input type="text" name="name" placeholder="Nome do Prato/Bebida" required>
                    <input type="text" name="description" placeholder="Descrição dos ingredientes" required>
                    <input type="number" name="price" step="0.01" min="0.01" placeholder="Preço (Ex: 15.50)" required>
                    <button type="submit" class="btn">Salvar no Cardápio</button>
                </form>
            </div>
        </details>
    </div>

    <h2 class="section-title">Painel de Produção (Kanban)</h2>

    <div class="kanban-board">
        <% const columns=['Aberto', 'Cozinha' , 'Entrega' , 'Entregue' ]; %>

            <% columns.forEach(col=> { %>
                <div class="kanban-col">
                    <h3 class="col-title">
                        <%= col %>
                    </h3>

                    <% orders.filter(o=> o.status === col).forEach(order => { %>
                        <div class="kanban-item">
                            <p><strong>Pedido #<%= order.id %></strong></p>
                            <p class="item-client">👤 <%= order.customer_name %>
                            </p>
                            <p class="item-desc">🛒 <%= order.items_description %>
                            </p>
                            <p class="item-price">R$ <%= Number(order.total).toFixed(2) %>
                            </p>
                            <p class="item-time">⏳ <%= new Date(order.created_at).toLocaleTimeString('pt-BR') %>
                            </p>

                            <div class="item-actions">
                                <% if (col==='Aberto' ) { %>
                                    <form action="/orders/<%= order.id %>/status" method="POST">
                                        <input type="hidden" name="status" value="Cozinha">
                                        <button type="submit" class="btn">Enviar p/ Cozinha 🍳</button>
                                    </form>
                                    <% } else if (col==='Cozinha' ) { %>
                                        <form action="/orders/<%= order.id %>/status" method="POST">
                                            <input type="hidden" name="status" value="Entrega">
                                            <button type="submit" class="btn">Saiu p/ Entrega 🛵</button>
                                        </form>
                                        <% } else if (col==='Entrega' ) { %>
                                            <form action="/orders/<%= order.id %>/status" method="POST">
                                                <input type="hidden" name="status" value="Entregue">
                                                <button type="submit" class="btn">Finalizar (Entregue) ✅</button>
                                            </form>
                                            <% } %>

                                                <% if (col !=='Entregue' ) { %>
                                                    <form action="/orders/<%= order.id %>/status" method="POST">
                                                        <input type="hidden" name="status" value="Cancelado">
                                                        <button type="submit" class="btn btn-danger">❌ Cancelar
                                                            Pedido</button>
                                                    </form>
                                                    <% } %>
                            </div>
                        </div>
                        <% }) %>
                </div>
                <% }) %>
    </div>

    <% const cancelados=orders.filter(o=> o.status === 'Cancelado'); %>
        <% if(cancelados.length> 0) { %>
            <h3 class="cancelados-title">Pedidos Cancelados</h3>
            <div class="cancelados-list">
                <% cancelados.forEach(order=> { %>
                    <div class="kanban-item kanban-item-cancelado">
                        <p><del>Pedido #<%= order.id %> - <%= order.customer_name %></del></p>
                        <p class="text-muted">
                            <%= order.items_description %>
                        </p>
                    </div>
                    <% }) %>
            </div>
            <% } %>

                <script>
                    let itensPedido = [];
                    let valorTotal = 0.0;

                    function adicionarAoPedido(nome, preco) {
                        itensPedido.push(nome);
                        valorTotal += preco;

                        const lista = document.getElementById('lista-itens');
                        const li = document.createElement('li');
                        li.textContent = `${nome} (R$ ${preco.toFixed(2)})`;
                        lista.appendChild(li);

                        document.getElementById('total-pedido').textContent = valorTotal.toFixed(2);
                        document.getElementById('input-descricao').value = itensPedido.join(' + ');
                        document.getElementById('input-total').value = valorTotal;
                    }

                    window.onload = () => {
                        const params = new URLSearchParams(window.location.search);
                        if (params.has('toast')) {
                            const snackbar = document.getElementById("snackbar");
                            const msg = params.get('toast').replace(/_/g, ' ');
                            snackbar.innerText = `✔️ ${msg}`;
                            snackbar.className = "toast show";
                            setTimeout(function () { snackbar.className = snackbar.className.replace("show", ""); }, 3000);
                            window.history.replaceState({}, document.title, "/dashboard");
                        }
                    };
                </script>
</body>

</html>