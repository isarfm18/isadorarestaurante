<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Isadora's Restaurant - Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: linear-gradient(135deg, #2b0a3d, #3a0f4f, #4a145f);
            color: #eee;
            min-height: 100vh;
            padding: 30px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            background: rgba(20, 5, 30, 0.95);
            padding: 20px 30px;
            border-radius: 18px;
            box-shadow: 0 10px 20px rgba(0,0,0,0.4);
        }

        .header h1 {
            color: #d16ba5;
            font-weight: 600;
        }

        .grid-forms {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 30px;
        }

        .card {
            background: rgba(20, 5, 30, 0.95);
            padding: 25px;
            border-radius: 18px;
            box-shadow: 0 10px 20px rgba(0,0,0,0.4);
        }

        .card h3 {
            color: #d16ba5;
            margin-bottom: 15px;
            border-bottom: 1px solid #5a2a6c;
            padding-bottom: 10px;
        }

        input, select {
            width: 100%;
            padding: 11px;
            margin-bottom: 15px;
            border-radius: 10px;
            border: 1px solid #5a2a6c;
            background-color: #2a0e3a;
            color: #fff;
            outline: none;
            transition: 0.3s;
        }

        input:focus, select:focus {
            border-color: #a4508b;
            box-shadow: 0 0 10px rgba(164, 80, 139, 0.5);
        }

        .btn {
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: 10px;
            background: linear-gradient(135deg, #7b2cbf, #a4508b);
            color: white;
            font-weight: 600;
            font-size: 15px;
            cursor: pointer;
            transition: 0.3s;
        }

        .btn:hover {
            opacity: 0.9;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.4);
        }

        .btn-small {
            padding: 6px 12px;
            font-size: 12px;
            margin-top: 10px;
        }

        ul.item-list {
            list-style: none;
        }

        ul.item-list li {
            background-color: #2a0e3a;
            padding: 10px;
            border-radius: 8px;
            margin-bottom: 8px;
            border-left: 4px solid #a4508b;
        }

        /* KANBAN BOARD */
        .kanban-board {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-top: 20px;
        }

        .kanban-col {
            background: rgba(20, 5, 30, 0.95);
            border-radius: 18px;
            padding: 20px;
            box-shadow: 0 10px 20px rgba(0,0,0,0.4);
            min-height: 400px;
        }

        .kanban-col h3 {
            color: #d16ba5;
            text-align: center;
            margin-bottom: 15px;
            border-bottom: 1px solid #5a2a6c;
            padding-bottom: 10px;
            font-size: 18px;
        }

        .kanban-card {
            background-color: #2a0e3a;
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 15px;
            border-left: 4px solid #a4508b;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
        }

        .kanban-card strong {
            display: block;
            font-size: 15px;
            color: #fff;
            margin-bottom: 5px;
        }

        .kanban-card em {
            font-size: 13px;
            color: #bbb;
            font-style: normal;
        }

        .kanban-form {
            margin-top: 10px;
        }
    </style>
</head>
<body>

    <div class="header">
        <h1>Painel Administrativo - Isadora's Restaurant</h1>
        <div>
            <a href="/admin/export" class="btn" style="text-decoration: none; padding: 10px 15px; margin-right: 15px; font-size: 14px; display: inline-block;">📊 Baixar Relatório</a>
            <a href="/" style="color: #bbb; text-decoration: none; font-weight: bold;">Sair</a>
        </div>
    </div>

    <div class="grid-forms">
        <div class="card">
            <h3>🍽️ Novo Item (Cardápio)</h3>
            <form action="/add-item" method="POST">
                <input type="text" name="name" placeholder="Nome (Ex: Batata Doce)" required>
                <input type="text" name="category" placeholder="Categoria (Ex: Carboidrato)">
                <input type="number" name="price" step="0.01" min="0.01" placeholder="Preço (Ex: 19.90)" required>
                <button type="submit" class="btn">Cadastrar Item</button>
            </form>
            
            <h3 style="margin-top: 20px;">📋 Itens Cadastrados</h3>
            <ul class="item-list">
                <% items.forEach(item => { %>
                    <li><strong><%= item.name %></strong> (<%= item.category %>) - R$ <%= Number(item.price).toFixed(2) %></li>
                <% }) %>
            </ul>
        </div>

        <div class="card">
            <h3>🛒 Lançar Novo Pedido</h3>
            <form action="/orders" method="POST">
                <input type="text" name="customer_name" placeholder="Nome do Cliente (Ex: João)" required>
                <select name="item_id" required>
                    <option value="" disabled selected>Selecione a Marmita...</option>
                    <% items.forEach(item => { %>
                        <option value="<%= item.id %>"><%= item.name %> - R$ <%= Number(item.price).toFixed(2) %></option>
                    <% }) %>
                </select>
                <button type="submit" class="btn">Registrar Pedido</button>
            </form>
        </div>
    </div>

    <div class="header" style="margin-bottom: 0;">
        <h2>📦 Kanban da Cozinha</h2>
    </div>

    <div class="kanban-board">
        <% 
            const statuses = [
                { id: 'Aberto', title: '🆕 Aberto', next: 'Cozinha' },
                { id: 'Cozinha', title: '🍳 Na Cozinha', next: 'Entrega' },
                { id: 'Entrega', title: '🛵 Em Entrega', next: 'Entregue' },
                { id: 'Entregue', title: '✅ Entregue', next: null }
            ];
        %>

        <% statuses.forEach(col => { %>
            <div class="kanban-col">
                <h3><%= col.title %></h3>
                <% 
                    const colOrders = orders ? orders.filter(o => o.status === col.id) : [];
                %>
                <% if (colOrders.length === 0) { %>
                    <p style="color: #777; font-size: 13px; text-align: center;">Vazio</p>
                <% } else { %>
                    <% colOrders.forEach(order => { %>
                        <div class="kanban-card">
                            <strong>#<%= order.id %> - <%= order.customer_name %></strong>
                            <em><%= order.item_name || 'Item Removido' %></em>
                            
                            <% if (col.next) { %>
                                <form action="/update-order-status" method="POST" class="kanban-form">
                                    <input type="hidden" name="order_id" value="<%= order.id %>">
                                    <input type="hidden" name="new_status" value="<%= col.next %>">
                                    <button type="submit" class="btn btn-small">Avançar ➔</button>
                                </form>
                            <% } %>
                        </div>
                    <% }) %>
                <% } %>
            </div>
        <% }) %>
    </div>

</body>
</html>
