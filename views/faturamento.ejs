<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Isadora's Restaurant - Faturamento do Dia</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="header">
        <h1>Faturamento do Dia 💰</h1>
        <div>
            <a href="/dashboard" class="btn" style="margin-right: 15px;">⬅️ Voltar ao Dashboard</a>
            <a href="/" style="color: #bbb; text-decoration: none; font-weight: bold;">Sair</a>
        </div>
    </div>

    <div class="card">
        <h2>Total Recebido Hoje</h2>
        <div class="faturamento-total">R$ <%= Number(total_hoje).toFixed(2).replace('.', ',') %></div>
    </div>

    <div class="table-container">
        <h2 style="color: #d16ba5; margin-bottom: 15px;">Vendas de Hoje</h2>
        <% if (orders_hoje.length === 0) { %>
            <p style="color: #bbb;">Nenhuma venda registrada hoje ainda.</p>
        <% } else { %>
            <table>
                <thead>
                    <tr>
                        <th>Pedido #</th>
                        <th>Cliente</th>
                        <th>Item</th>
                        <th>Valor</th>
                        <th>Status</th>
                        <th>Horário</th>
                    </tr>
                </thead>
                <tbody>
                    <% orders_hoje.forEach(order => { %>
                        <tr>
                            <td><%= order.id %></td>
                            <td><%= order.customer_name %></td>
                            <td><%= order.item_name %></td>
                            <td>R$ <%= Number(order.price).toFixed(2).replace('.', ',') %></td>
                            <td><%= order.status %></td>
                            <td><%= new Date(order.created_at).toLocaleTimeString('pt-BR') %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } %>
    </div>
</body>
</html>
